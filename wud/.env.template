# wud's newer image made login mandatory. Pick a real password (not this
# placeholder) for both of these.
WUD_AUTH_ADMIN_USER=admin
WUD_AUTH_ADMIN_PASSWORD=

# VictoriaMetrics scrapes wud's /metrics with basic auth (see
# victoria-metrics/vmscrape.yml), and its scrape config can only take a bare
# password file, not a KEY=VALUE env file. After setting
# WUD_AUTH_ADMIN_PASSWORD above, also write the *same* password with no
# trailing newline to ./wud/metrics_password (gitignored):
#
#   printf '%s' 'your-password-here' > wud/metrics_password
#
# Keep the two in sync by hand if you ever rotate the password.
