# ai-brain configuration. Every variable read by ai_brain.config.load_settings.
# Values shown are the defaults; blank means "no default, unset unless you need it".

# --- memory and seed ------------------------------------------------------
# Where the agents' markdown memory lives (a docker volume in production).
MEMORY_ROOT=/memory
# Starting constitution and personas. Defaults to the seed/ dir shipped in the image.
SEED_ROOT=

# --- model ----------------------------------------------------------------
# Comma-separated provider:model ids, tried in order until one answers. Best
# model first; local hardware is what the free tier falls back to:
#   gemini: the free tier, until the ledger says each key's quota is gone.
#   lan:    a model on whatever machine on the LAN is awake and has it pulled,
#           found by sweeping the network (see the "local models" section).
#   ollama: the small model on the rpi5's own ollama service, the last resort.
LLM_CHAIN=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,lan:deepseek-r1:8b,ollama:llama3.2:3b
GEMINI_API_KEY=
OLLAMA_URL=http://ollama:11434
# Gemini thinking budget per call: -1 lets the model decide, a positive number
# caps it, 0 sends no thinkingConfig at all. A model that rejects the field is
# retried once without it, so this is safe to leave on for a mixed chain.
GEMINI_THINKING_BUDGET=-1

# --- agents ---------------------------------------------------------------
# Comma-separated expert names. Each needs seed/personas/<name>.md.
# Known names: energy, health, house-ops, researcher. Unset or blank means all
# four; set a shorter list, or EXPERTS=none, to cut back to the brain alone.
EXPERTS=energy,health,house-ops,researcher
# How often each loop wakes up, in minutes.
BRAIN_HEARTBEAT_MIN=30
EXPERT_HEARTBEAT_MIN=120

# --- VictoriaMetrics ------------------------------------------------------
VM_URL=http://database-auth:8427
INFLUX_TOKEN=

# --- Home Assistant -------------------------------------------------------
HA_URL=http://192.168.68.87:8123
HA_TOKEN=
HA_TODO_LIST=todo.shopping_list

# --- other services -------------------------------------------------------
GDRIVE_RAG_URL=http://gdrive-rag:8090
SONOS_URL=http://sonos-http-api:5005
SONOS_ROOM=Kitchen
BRAVE_API_KEY=

# --- Slack ----------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_ID=

# --- local models on the LAN ----------------------------------------------
# Subnets to sweep for a host serving the `lan:` model, comma-separated. Empty
# means the /24 that HA_URL is on, which is the LAN -- this container's own
# address is a docker bridge.
LAN_SUBNETS=
# Minutes between sweeps. A known host is confirmed with one request; only a
# host that stopped answering costs a full sweep.
LAN_SCAN_MIN=10

# --- safety and rate limits ----------------------------------------------
# DRY_RUN=1 means no side effects leave the process (exactly "1", nothing else).
DRY_RUN=0
# Gemini free-tier budget: requests/min, tokens/min, requests/day.
RPM=8
TPM=200000
RPD=200
# Seconds a single model call may take before the chain falls to the next provider.
CALL_TIMEOUT_S=60
# How much work one cycle may do: tool rounds before the loop gives up waiting
# for end_cycle, and output tokens per round.
CYCLE_MAX_ROUNDS=16
CYCLE_MAX_TOKENS=8000

# --- read-only HTTP introspection API -------------------------------------
# Port the GET-only status API binds inside the container. 0 disables it.
# Only published to the LAN by docker-compose.local.yml.
HTTP_PORT=8091
