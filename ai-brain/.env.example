# ai-brain configuration. Every variable read by ai_brain.config.load_settings.
# Values shown are the defaults; blank means "no default, unset unless you need it".

# --- memory and seed ------------------------------------------------------
# Where the agents' markdown memory lives (a docker volume in production).
MEMORY_ROOT=/memory
# Starting constitution and personas. Defaults to the seed/ dir shipped in the image.
SEED_ROOT=

# --- model ----------------------------------------------------------------
# Comma-separated provider:model ids, tried in order until one answers. Best
# model first; local hardware is what the free tier falls back to:
#   gemini: the free tier, until the ledger says each key's quota is gone.
#   lan:    a model on whatever machine on the LAN is awake and has it pulled,
#           found by sweeping the network (see the "local models" section).
#   ollama: the small model on the rpi5's own ollama service, the last resort.
LLM_CHAIN=gemini:gemini-3.8-flash,lan:qwen3.8:27b-mlx,gemini:gemini-3.5-flash-lite,lan:qwen3-coder:30b
# Which chain keys each kind of loop may use ("all" = whole chain). Default:
# the brain gets gemini-3.8-flash only, experts get everything else.
#BRAIN_MODELS=gemini:gemini-3.8-flash
#EXPERT_MODELS=
GEMINI_API_KEY=
OLLAMA_URL=http://ollama:11434
# Context window (tokens) requested per call via options.num_ctx on Ollama's
# native /api/chat endpoint, per model: pattern=N entries, fnmatch-style
# against the LLM_CHAIN entry, first match wins. No match falls back to 32768
# for lan: (a desktop on the LAN) and 16384 for ollama: (the rpi5's own
# service, 8GB RAM). Ollama's server default is 4096 and it truncates an
# oversized prompt silently from the *front*, so the window is always set.
# N must be 4096-262144. Unset or blank uses this default; "none"/"off" keeps
# every provider on its fallback. The per-request value overrides the host's
# own default -- keep N within what its RAM can hold.
NUM_CTX_BY_MODEL=lan:qwen3.8*=131072,lan:qwen3*=32768,ollama:*=16384
# Ollama's think field per model (lan:/ollama: only), pattern=level with
# level one of true/false/low/medium/high/xhigh. No match sends none (model
# default). Qwen3.8 runs medium for any value it doesn't know -- use xhigh.
# "none"/"off" disables.
THINK_BY_MODEL=lan:qwen3.8*=xhigh
# Gemini thinking budget per call: -1 lets the model decide, a positive number
# caps it, 0 sends no thinkingConfig at all. A model that rejects the field is
# retried once without it, so this is safe to leave on for a mixed chain.
GEMINI_THINKING_BUDGET=-1

# --- agents ---------------------------------------------------------------
# Comma-separated expert names. Each needs seed/personas/<name>.md.
# Known names: energy, health, house-ops, researcher, infra. Unset or blank
# means all five; set a shorter list, or EXPERTS=none, to cut back to the
# brain alone.
EXPERTS=energy,health,house-ops,researcher,infra
# How often each loop wakes up, in minutes.
BRAIN_HEARTBEAT_MIN=240
EXPERT_HEARTBEAT_MIN=120

# --- VictoriaMetrics ------------------------------------------------------
VM_URL=http://database-auth:8427
INFLUX_TOKEN=

# --- Home Assistant -------------------------------------------------------
HA_URL=http://192.168.68.87:8123
HA_TOKEN=
HA_TODO_LIST=todo.shopping_list

# --- Docker -----------------------------------------------------------------
# The socket-proxy sidecar's address. ai-brain never mounts docker.sock
# itself -- see the docker-proxy service in docker-compose.yml.
DOCKER_PROXY_URL=http://docker-proxy:2375

# --- other services -------------------------------------------------------
GDRIVE_RAG_URL=http://gdrive-rag:8090
SONOS_URL=http://sonos-http-api:5005
SONOS_ROOM=Kitchen
BRAVE_API_KEY=

# --- Slack ----------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_ID=

# --- local models on the LAN ----------------------------------------------
# Subnets to sweep for a host serving the `lan:` model, comma-separated. Empty
# means the /24 that HA_URL is on, which is the LAN -- this container's own
# address is a docker bridge.
LAN_SUBNETS=
# Minutes between sweeps. A known host is confirmed with one request; only a
# host that stopped answering costs a full sweep.
LAN_SCAN_MIN=10

# --- safety and rate limits ----------------------------------------------
# DRY_RUN=1 means no side effects leave the process (exactly "1", nothing else).
DRY_RUN=0
# Gemini free-tier budget: requests/min, tokens/min, requests/day.
RPM=8
TPM=200000
RPD=200
# Seconds a single model call may take before the chain falls to the next provider.
CALL_TIMEOUT_S=60
# How much work one cycle may do: tool rounds before the loop gives up waiting
# for end_cycle, and output tokens per round.
CYCLE_MAX_ROUNDS=16
CYCLE_MAX_TOKENS=8000
# Per-model override of CYCLE_MAX_ROUNDS: comma-separated pattern=N entries,
# fnmatch-style against the chain key that answered the most recent round
# (provider:model, e.g. gemini:gemini-3.8-flash or lan:qwen3-coder:30b -- the
# same shape as an LLM_CHAIN entry). First match wins; no match falls back to
# CYCLE_MAX_ROUNDS. N must be 1-64 (CYCLE_MAX_ROUNDS_HARD_CEILING). The cap in
# force is the limit of whichever model answered last, so a cycle that starts
# strong and falls back to a weak model gets cut at the weak limit.
# Unset or blank uses this documented default; "none" or "off" (case-
# insensitive) disables per-model caps entirely so every cycle just gets the
# flat CYCLE_MAX_ROUNDS.
CYCLE_MAX_ROUNDS_BY_MODEL=gemini:*3.8*=32,lan:qwen3.8*=32
# Per-model override of CYCLE_MAX_PROMPT_TOKENS (below), matched against the
# model that answered the latest round. Local models are free per token, so a
# much larger, still finite budget. 0 = no budget for that model; "none"/"off"
# gives every model the flat budget.
CYCLE_MAX_PROMPT_TOKENS_BY_MODEL=lan:*=2000000,ollama:*=2000000
# Per-cycle prompt-token budget across every round combined. 0 disables it.
# Crossing it mid-cycle behaves like a per-model cap drop: the wrap-up nudge
# fires (if it hasn't already), at most two more rounds are allowed, then the
# cycle stops with status max_rounds and a summary naming the token budget.
CYCLE_MAX_PROMPT_TOKENS=400000

# --- read-only HTTP introspection API -------------------------------------
# Port the GET-only status API binds inside the container. 0 disables it.
# Only published to the LAN by docker-compose.local.yml.
HTTP_PORT=8091
# Memory MCP for a coding agent (Claude Code): read/refactor facts, journals,
# gaps, personas, goals, constitution. 0 disables. Blank token = read-only;
# with a token every request needs "Authorization: Bearer <token>".
MCP_PORT=8092
MCP_TOKEN=

# --- brain's own repo snapshot (code_* tools) ------------------------------
# The public GitHub repo the brain reads its own and its siblings' source
# from -- the tracked-files-only tarball, never the rpi5 checkout (which
# holds untracked secrets). See "Reading the repo" in README.md.
REPO_SLUG=tkhduracell/iot-fetcher
REPO_REF=main
# Hours between snapshot refreshes. Also refreshed once on boot.
REPO_REFRESH_H=6

# --- rejection memory -------------------------------------------------------
# How many days a rejected proposal keeps blocking a repeat with the same
# kind+target. See approvals.py's rejection-memory section and propose.py's
# guard.
REJECTION_MEMORY_DAYS=30

# Airbnb calendar (Google Calendar "Uthyrningar"): its SECRET iCal address.
# A credential -- keep it here only. Enables the airbnb_calendar tool
# (researcher, energy, house-ops) and the Slack cleaning reminder for
# back-to-back changeovers, sent after AIRBNB_REMINDER_HOUR (Stockholm time)
# the day before, or on the day itself if that was missed.
AIRBNB_ICAL_URL=
#AIRBNB_REMINDER_HOUR=18
